{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "happycampr_carousels/decisions/decisions.schema.json",
  "title": "Decision review export",
  "description": "Shape of the file exported by decisions/index.html. One file per review topic; re-importable to continue a review.",
  "type": "object",
  "required": ["project", "topic", "decisions"],
  "additionalProperties": true,
  "properties": {
    "project": { "type": "string", "const": "happycampr_carousels" },
    "topic": { "type": "string", "description": "What was reviewed, e.g. 'plate-chart (Charts.css) slide type'." },
    "generatedAt": { "type": "string", "description": "Date the reviewed work was produced (YYYY-MM-DD)." },
    "exportedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of this export." },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "approve": { "type": "integer" },
        "revise": { "type": "integer" },
        "reject": { "type": "integer" },
        "undecided": { "type": "integer" }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string", "pattern": "^D[0-9]+$" },
          "title": { "type": "string" },
          "verdict": { "type": "string", "enum": ["approve", "revise", "reject", "undecided"] },
          "comment": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "changeNotes": {
      "type": "array",
      "description": "Optional free-text notes against each changed file.",
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]+$" },
          "file": { "type": "string" },
          "comment": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "generalComment": { "type": "string" }
  }
}
